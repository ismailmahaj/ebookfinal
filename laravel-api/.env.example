APP_NAME="Ebook Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-api.up.railway.app

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# URL du frontend (redirections Stripe Checkout)
FRONTEND_URL=https://votre-frontend.up.railway.app

# CORS (optionnel — par défaut = FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=https://votre-frontend.up.railway.app,https://www.votre-domaine.com

# Stripe (abonnements)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Sanctum (non requis avec auth Bearer token, utile si cookies SPA plus tard)
SANCTUM_STATEFUL_DOMAINS=votre-frontend.up.railway.app

# Base de données — Railway MySQL (référencer les variables du plugin)
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

LOG_CHANNEL=stderr
LOG_LEVEL=info

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@votre-domaine.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stockage S3 (optionnel — sinon monter un volume Railway sur storage/app)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
